# Configuration for AtomS3 Lite (8 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"

# Spezifische GPIOs & Konfliktvermeidung für AtomS3
CONFIG_TEE_FLASH_SIZE_8MB=y
CONFIG_TEE_SHELL_TX_PIN=6
CONFIG_TEE_SHELL_RX_PIN=5
CONFIG_TEE_DISABLE_BETRIEBSARTKONTAKT=y
